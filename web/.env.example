# Copy to .env.local for local development. All are optional: without them the
# checker still works; accounts and AI summaries show a "not configured" state.

# Supabase (browser + server). Safe to expose: access is enforced by row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Same values, read by the Python API for the per-user quota.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only secrets. Never commit a real key.
# Free key from Google AI Studio (aistudio.google.com/apikey).
GEMINI_API_KEY=
# Optional. Claude models are only offered when this is set.
ANTHROPIC_API_KEY=
# Comma-separated models offered on the Try page. Names starting with "gemini" use
# GEMINI_API_KEY; names starting with "claude" use ANTHROPIC_API_KEY.
AI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,claude-haiku-5-5

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 1 after enabling the GitHub provider in Supabase to show "Continue with GitHub".
NEXT_PUBLIC_AUTH_GITHUB=
